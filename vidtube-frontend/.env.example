# ===========================================
# VIDTUBE FRONTEND - ENVIRONMENT VARIABLES
# ===========================================

# Local development API URL
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Vercel production API URL example
# VITE_API_BASE_URL=https://your-backend-service.onrender.com/api/v1

# Optional fallback key (used only if VITE_API_BASE_URL is not set)
# VITE_API_URL=https://your-backend-service.onrender.com/api/v1

# Cloudinary Configuration (Optional - for direct uploads)
# VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
# VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

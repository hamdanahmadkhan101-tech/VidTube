# ===========================================
# VIDTUBE BACKEND - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your values

# Server Configuration
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# MongoDB Connection
# Get this from MongoDB Atlas: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

# JWT Secrets (generate secure random strings)
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=your-super-secret-access-token-key-min-32-chars
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-min-32-chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Cloudinary Configuration
# Get these from: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Transactional Email (Brevo)
# Sender email must be verified in Brevo.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM_NAME=VidTube
MAIL_FROM_EMAIL=your-verified-sender-email

# OTP / Email Verification
OTP_HASH_PEPPER=replace-with-random-hex-secret
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DAILY_SEND_LIMIT=5
ACCOUNT_VERIFICATION_REQUIRED=false

# CORS Configuration
# Primary frontend URL (single origin)
# Example: https://your-app.vercel.app
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Additional allowed frontend origins (comma-separated)
# Example: https://your-app.vercel.app,https://www.your-domain.com
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app

# Runtime / Ops
BODY_SIZE_LIMIT=1mb
METRICS_TOKEN=your-metrics-token
ENABLE_DEBUG_ROUTES=false

# Distributed Cache (Redis / Upstash Redis)
# Example: rediss://default:<password>@<host>:<port>
REDIS_URL=
CACHE_ENABLED=true

# IMPORTANT: if one Redis DB is shared across multiple apps,
# use a unique prefix per app and environment to avoid key collisions.
# Example: CACHE_PREFIX=vidtube:prod:api
CACHE_PREFIX=vidtube

# Set a short TTL for hot-read API response cache entries.
CACHE_DEFAULT_TTL_SECONDS=60

# Distributed Rate Limiting (Redis-backed express-rate-limit store)
# Enable Redis store for rate limits; set false to use in-memory fallback.
RATE_LIMIT_REDIS_ENABLED=true

# Use a unique prefix for rate limit keys (especially in a shared single Redis DB).
# Example: RATE_LIMIT_PREFIX=vidtube:prod:api:ratelimit:
RATE_LIMIT_PREFIX=vidtube:ratelimit:

